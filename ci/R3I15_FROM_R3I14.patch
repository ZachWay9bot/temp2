+/* R3I15: normal VESC drive commands must be sufficient to prepare the
+ * validated passive pushstart path. The previous test-only CLI command
+ * g30_pushstart arm must no longer be required for real VESC Tool use. */
+static void g30_vesc_auto_arm_pushstart(void){
+    if(g30_r3i_sensorless_active() || g30_r3i_block_pwm_start()) return;
+    VescToSTM_pwm_stop();
+    g30_fo76_sensorless_clear();
+    g30_fo76_request_takeover(0u);
+    g30_r3i_request_arm(1u);
+    if(STM_GetState(&STM[M1])==IDLE){
+        MCI_ExecSpeedRamp(pMCI[M1],0,0);
+        (void)MCI_StartMotor(pMCI[M1]);
+    }
+}
+#endif
 
