+#ifdef G30P
+static void g30_dash_send_status(port_str *port){
+    /* Exact native G30 status shape observed on stock/EBiCS captures:
+     * 20->21 CMD64 ARG00 LEN6 = mode,battery,light,beep,speed,fault. */
+    uint8_t tx[15]={0x5A,0xA5,0x06,0x20,0x21,0x64,0x00,0,0,0,0,0,0,0,0};
+    float level=VescToSTM_get_battery_level(0);
+    float kph=fabsf(VescToSTM_get_speed()*3.6f);
+    if(level<0.0f) level=0.0f; if(level>1.0f) level=1.0f;
+    if(kph>255.0f) kph=255.0f;
+    tx[7]=m365_to_display.mode;
+    tx[8]=(uint8_t)(level*100.0f+0.5f);
+    tx[9]=m365_to_display.light;
+    tx[10]=0;
+    tx[11]=(uint8_t)(kph+0.5f);
+    tx[12]=(uint8_t)(pMCI[M1]->pSTM->hFaultOccurred & 0xFFu);
+    uint16_t sum=0;
+    for(unsigned i=2;i<=12;i++) sum=(uint16_t)(sum+tx[i]);
+    uint16_t crc=(uint16_t)(~sum);
+    tx[13]=(uint8_t)crc; tx[14]=(uint8_t)(crc>>8);
+    my_uart_send_data(tx,sizeof(tx),port);
+}
+#endif
