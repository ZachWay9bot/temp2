+#ifdef G30P
+    /* G30 native Yellow-wire framing:
+     * 5A A5 LEN SRC DST CMD ARG DATA[LEN] CHECKSUM16_LE
+     * checksum = bitwise NOT of the 16-bit sum from LEN through DATA. */
+    enum { G30_IDLE, G30_HEAD, G30_LEN, G30_SRC, G30_DST, G30_CMD, G30_ARG, G30_DATA, G30_CRC };
+    static uint8_t state=G30_IDLE, cnt=0, dst=0;
+    static uint16_t checksum=0;
+    static uint8_t crc_lo=0;
+    switch(state){
+    case G30_IDLE:
+        if(data==0x5A) state=G30_HEAD;
+        break;
+    case G30_HEAD:
+        state=(data==0xA5)?G30_LEN:G30_IDLE;
+        break;
+    case G30_LEN:
+        if(data>NinebotMaxPayload){state=G30_IDLE;break;}
+        message->len=data; checksum=data; cnt=0; state=G30_SRC;
+        break;
+    case G30_SRC:
+        message->addr=data; checksum=(uint16_t)(checksum+data); state=G30_DST;
+        break;
+    case G30_DST:
+        dst=data; checksum=(uint16_t)(checksum+data); state=G30_CMD;
+        break;
+    case G30_CMD:
+        message->cmd=data; checksum=(uint16_t)(checksum+data); state=G30_ARG;
+        break;
+    case G30_ARG:
+        message->arg=data; checksum=(uint16_t)(checksum+data);
+        state=message->len?G30_DATA:G30_CRC;
+        break;
+    case G30_DATA:
+        message->payload[cnt++]=data; checksum=(uint16_t)(checksum+data);
+        if(cnt>=message->len){cnt=0;state=G30_CRC;}
+        break;
+    case G30_CRC:
+        if(cnt==0){crc_lo=data;cnt=1;}
+        else{
+            uint16_t wire=(uint16_t)crc_lo|((uint16_t)data<<8);
+            uint16_t calc=(uint16_t)(~checksum);
+            state=G30_IDLE;cnt=0;
+            if(wire==calc && dst==0x20) return 0;
+        }
+        break;
+    default:
+        state=G30_IDLE;cnt=0;break;
+    }
+    return 1;
+#else
+    static uint8_t state = NIN_IDLE;
+    static uint8_t cnt = 0;
+    static uint16_t checksum=0;
+    switch (state){
+    case NIN_IDLE:
+        if(data==NinebotHeader0) state = NIN_HEAD;
+        break;
+    case NIN_HEAD:
+        if(data==NinebotHeader1) state = NIN_LEN;
+        break;
+    case NIN_LEN:
+        message->len = data-1;
+        checksum=0;
+        checksum=checksum + data;
+        state = NIN_ADDR;
+        break;
+    case NIN_ADDR:
+        cnt++;
+        state = NIN_CMD;
+        checksum=checksum + data;
+        message->addr = data;
+        break;
+    case NIN_CMD:
+        cnt=0;
+        state = NIN_ARG;
+        checksum=checksum + data;
+        message->cmd = data;
+        break;
+    case NIN_ARG:
+        cnt++;
+        state = NIN_DATA;
+        checksum=checksum + data;
+        message->arg = data;
+        break;
+    case NIN_DATA:
+        cnt++;
+        checksum=checksum + data;
+        if((cnt-2) < NinebotMaxPayload){
+            message->payload[cnt-2] = data;
+        }
+        if(cnt == (message->len)){
+            state = NIN_CRC;
+            cnt=0;
+        }
+        break;
+    case NIN_CRC:
+        message->CheckSum[cnt] = data;
+        if(cnt==1){
+            checksum ^= 0xFFFF;
+            state = NIN_IDLE;
+            return checksum - ((message->CheckSum[1]<<8) + message->CheckSum[0]);
+        }
+        cnt++;
+        break;
+    }
+    return 1;
+#endif
