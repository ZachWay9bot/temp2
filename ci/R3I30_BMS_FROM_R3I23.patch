+/* G30 stock-BMS reads. Golden wire bytes are derived from DRV126, not G2. */
+#ifndef G30_BMS_LOGIC_H
+#define G30_BMS_LOGIC_H
+#include "g30_dash_proto.h"
+#include <stdbool.h>
+
+#define G30_BMS_POLL_MS 105u
+#define G30_BMS_FRESH_MS 1000u
+
+typedef struct {
+    uint32_t last_tx_ms, last_status_ms;
+    uint8_t tx_started, identity_seen, status_seen;
+    uint8_t identity[16], status[12];
+} g30_bms_control;
+
+/* 5A A5 01 20 22 01 REG COUNT CKlo CKhi. LEN is included in the sum. */
+static inline void g30_bms_read_frame(uint8_t reg, uint8_t count, uint8_t out[10]) {
+    out[0]=0x5a; out[1]=0xa5; out[2]=1; out[3]=0x20; out[4]=0x22;
+    out[5]=1; out[6]=reg; out[7]=count;
+    uint16_t sum=0;
+    for(unsigned i=2;i<8;i++) sum+=out[i];
+    sum^=0xffffu; out[8]=(uint8_t)sum; out[9]=(uint8_t)(sum>>8);
+}
+
+/* First read identity; retry while disconnected. There is no motor interlock.
+ * Successful identity reception switches subsequent requests to status. */
+static inline bool g30_bms_next_read(g30_bms_control *c, uint32_t now,
+        uint8_t out[10]) {
+    if(c->tx_started && (uint32_t)(now-c->last_tx_ms)<G30_BMS_POLL_MS) return false;
+    c->last_tx_ms=now; c->tx_started=1;
+    if(c->identity_seen) g30_bms_read_frame(0x30,12,out);
+    else g30_bms_read_frame(0x10,16,out);
+    return true;
+}
+
+/* Call only after the parser validated the checksum. Accept exact stock read
+ * replies, never echo requests or frames from dashboard/external batteries. */
+static inline bool g30_bms_accept(g30_bms_control *c,
+        const g30_dash_parser *p, uint32_t now) {
+    if(p->src!=0x22 || p->dst!=0x20 || p->cmd!=4) return false;
+    if(p->arg==0x10 && p->len==16) {
+        memcpy(c->identity,p->payload,16); c->identity_seen=1; return true;
+    }
+    if(p->arg==0x30 && p->len==12) {
+        memcpy(c->status,p->payload,12); c->status_seen=1;
+        c->last_status_ms=now; return true;
+    }
+    return false;
+}
+
+static inline bool g30_bms_status_fresh(const g30_bms_control *c, uint32_t now) {
+    return c->status_seen && (uint32_t)(now-c->last_status_ms)<=G30_BMS_FRESH_MS;
+}
+#endif
