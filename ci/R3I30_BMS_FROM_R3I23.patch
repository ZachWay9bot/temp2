+/* R3I30: one BMS-UART3 owner, serviced by the existing DASH task. No motor
+ * setters, no BMS writes/flash, no extra task or stack, no IoT UART changes. */
+#include "main.h"
+#include "task_init.h"
+#include "g30_bms_link.h"
+#include "g30_bms_logic.h"
+#include "VescCommand.h"
+
+#ifdef G30P
+typedef struct {
+    g30_dash_parser parser;
+    g30_bms_control control;
+    uint32_t bytes, valid, bad, ignored, tx_ok, tx_fail, rx_errors;
+    uint8_t rx[128];
+    uint8_t rd, rx_result;
+} g30_bms_link_state;
+
+static g30_bms_link_state *bms;
+static uint32_t alloc_failed;
+
+void g30_bms_link_start(void) {
+    if(bms) return;
+    g30_bms_link_state *d=pvPortMalloc(sizeof(*d));
+    if(!d){alloc_failed++;return;}
+    memset(d,0,sizeof(*d)); bms=d;
+    /* main.c / MSP already configure USART3, PB10 TX / PB11 RX at 115200 8N1.
+     * Do not reinitialize any UART or change the existing USART1 IoT owner. */
+    d->rx_result=(uint8_t)HAL_UART_Receive_DMA(&huart3,d->rx,sizeof(d->rx))+1u;
+    if(d->rx_result==1u) {
+        CLEAR_BIT(huart3.Instance->CR3,USART_CR3_EIE);
+        __HAL_DMA_DISABLE_IT(huart3.hdmarx,DMA_IT_HT|DMA_IT_TC);
+    }
+}
+
+void g30_bms_link_poll(void) {
+    g30_bms_link_state *d=bms;
+    if(!d || d->rx_result!=1u) return;
+    uint32_t now=HAL_GetTick();
+    /* Bounded drain even with a continuously noisy or wrongly wired input. */
+    for(unsigned budget=0;budget<sizeof(d->rx);budget++) {
+        unsigned wr=(128u-huart3.hdmarx->Instance->CNDTR)&127u;
+        if(d->rd==wr) break;
+        uint8_t byte=d->rx[d->rd]; d->rd=(uint8_t)((d->rd+1u)&127u); d->bytes++;
+        int result=g30_dash_feed(&d->parser,byte,now);
+        if(result<0) d->bad++;
+        if(result==1) {
+            if(g30_bms_accept(&d->control,&d->parser,now)) d->valid++;
+            else d->ignored++;
+        }
+    }
+    if(huart3.Instance->SR&(USART_SR_ORE|USART_SR_FE|USART_SR_NE|USART_SR_PE)) {
+        d->rx_errors++; __HAL_UART_CLEAR_OREFLAG(&huart3);
+    }
+    uint8_t tx[10];
+    if(g30_bms_next_read(&d->control,now,tx)) {
+        /* Full-duplex: RX DMA stays enabled during TX. Ten bytes take <1 ms.
+         * Bounded blocking TX avoids a buffer lifetime/DMA callback dependency. */
+        if(HAL_UART_Transmit(&huart3,tx,sizeof(tx),3u)==HAL_OK) d->tx_ok++;
+        else d->tx_fail++;
+    }
+}
+
+void g30_bms_link_print(PACKET_STATE_t *phandle) {
+    g30_bms_link_state *d=bms;
+    if(!d){commands_printf(phandle,"BMS UART3 started=0 allocFail=%lu",(unsigned long)alloc_failed);return;}
+    uint32_t now=HAL_GetTick();
+    commands_printf(phandle,"BMS UART3 tx=PB10 rx=PB11 baud=115200 rxDMA=%u bytes=%lu valid=%lu bad=%lu ignored=%lu",
+        d->rx_result,(unsigned long)d->bytes,(unsigned long)d->valid,
+        (unsigned long)d->bad,(unsigned long)d->ignored);
+    commands_printf(phandle,"BMS txOK=%lu txFail=%lu rxErr=%lu identity=%u status=%u fresh=%u poll_ms=%u age_ms=%lu",
+        (unsigned long)d->tx_ok,(unsigned long)d->tx_fail,(unsigned long)d->rx_errors,
+        d->control.identity_seen,d->control.status_seen,g30_bms_status_fresh(&d->control,now),
+        G30_BMS_POLL_MS,(unsigned long)(d->control.status_seen?now-d->control.last_status_ms:0u));
+    /* Raw register values: no claim that a reply proves 40 A capability. */
+    const uint8_t *s=d->control.status;
+    commands_printf(phandle,"BMS regs30_35=%02x%02x,%02x%02x,%02x%02x,%02x%02x,%02x%02x,%02x%02x",
+        s[1],s[0],s[3],s[2],s[5],s[4],s[7],s[6],s[9],s[8],s[11],s[10]);
+    commands_printf(phandle,"BMS requests=READ_ONLY id=5AA50120220110109BFF status=5AA501202201300C7FFF");
+}
+#else
+void g30_bms_link_start(void) {}
+void g30_bms_link_poll(void) {}
+void g30_bms_link_print(PACKET_STATE_t *phandle) {(void)phandle;}
+#endif
