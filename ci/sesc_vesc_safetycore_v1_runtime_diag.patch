+static void VescToSTM_g30_hybrid_supervisor(void){
+    if(!VescToSTM_g30_hall_selected()) return;
+    g30_vbus_fusion_result_t vfr=g30_vbus_fusion_runtime_result();
+    int16_t hdpp=HALL_M1._Super.hElSpeedDpp;
+    uint8_t vbus_ok=(uint8_t)(vfr.sensorless_ok &&
+        vfr.source==G30_VBUS_SRC_PA1 && vfr.pa1_mv<=45000u);
+
+    /* Once observer angle owns FOC, never snap live PWM back to Hall merely
+     * because the voltage trust window closes. Request the existing coast
+     * path instead; the 16-kHz and medium tasks remove PWM deterministically. */
+    if(g30_fo76_takeover_owns_angle()){
+        if(!vbus_ok) g30_fo76_request_coast();
+        return;
+    }
+
+    /* A failed pre-ownership blend is Hall-safe, but must not chatter between
+     * Hall and repeated takeover attempts while the same throttle command is
+     * held. Release/zero clears the FO76 state through g30_coast_rearm(). */
+    if(g30_fo76_takeover_fallback_latched()) return;
+
+    /* Physical forward on the validated G30 frame is negative DPP. Request
+     * takeover at the same 64-DPP threshold used by the proven push-start
+     * path (~3 km/h). FO76 itself still requires valid+tracking+phase agreement
+     * before it blends away from Hall. Reverse remains Hall-only for now. */
+    if(vbus_ok && VescToSTM_g30_hall_feedback_valid() &&
+       hdpp<=-(int16_t)G30_HYBRID_TAKEOVER_MIN_DPP){
+        g30_fo76_request_takeover(1u);
+    }else{
+        g30_fo76_request_takeover(0u);
+    }
+}
