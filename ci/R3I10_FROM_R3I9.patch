+#ifndef G30_R3I_PRELOAD_H
+#define G30_R3I_PRELOAD_H
+#include <stdint.h>
+
+/* Passive catch starts with negligible stator current: Vq = omega_e*lambda,
+ * Vd = 0. MCSDK SVPWM maps 32768 voltage counts to Vbus/sqrt(3), not Vbus.
+ * Speed is electrical phase counts per 16 kHz FOC tick, lambda is micro-Wb.
+ * Consequently Vq_counts = speed_dpp*lambda_uWb*16*pi*sqrt(3)/Vbus_mV.
+ * Integer arithmetic is used only at PWM startup, never in the fast loop. */
+typedef struct {
+    int16_t vq_counts;
+    int16_t vd_counts;
+    int32_t bemf_mv;
+} g30_r3i_preload_result_t;
+
+static inline int64_t g30_r3i_round_div(int64_t numerator, int64_t denominator) {
+    return (numerator + (numerator < 0 ? -denominator/2 : denominator/2))/denominator;
+}
+
+static inline g30_r3i_preload_result_t g30_r3i_preload_calculate(
+        int16_t speed_dpp, uint16_t lambda_uwb, uint16_t vbus_mv) {
+    g30_r3i_preload_result_t out = {0, 0, 0};
+    if (!lambda_uwb || vbus_mv < 4000u || vbus_mv > 60000u) return out;
+    int64_t product = (int64_t)speed_dpp * lambda_uwb;
+    /* 16*pi*sqrt(3) = 87.06236948...; 2*pi*16000/(65536*1000)
+     * = 0.001533980788... mV / (dpp*micro-Wb). */
+    int64_t q = g30_r3i_round_div(product * 8706237, (int64_t)vbus_mv * 100000);
+    if (q > 32767) q = 32767;
+    if (q < -32767) q = -32767;
+    out.vq_counts = (int16_t)q;
+    out.bemf_mv = (int32_t)g30_r3i_round_div(product * 1533981, 1000000000);
+    return out;
+}
+
+static inline int32_t g30_r3i_preload_integral(
+        int16_t voltage, uint16_t ki_divisor, int32_t lower, int32_t upper) {
+    int32_t integral = (int32_t)voltage * ki_divisor;
+    if (integral < lower) integral = lower;
+    if (integral > upper) integral = upper;
+    return integral;
+}
+#endif
