+#ifdef G30_DASH_APPCOMPAT_V3
+/* Lucidnx/G30 hardware strategy: never open a separate Yellowwire TX window
+ * just for an app read. Keep only the request descriptor and append its CMD04
+ * reply to the next normal CMD64 status transmission. The dashboard protocol
+ * is framed by 5A A5 + LEN, so multiple complete frames may share one TX. */
+static bool g30_dash_defer_app_read(dash_link_state *d){
+    const g30_dash_parser *p=&d->parser;
+    if((p->src<0x3Du||p->src>0x3Fu) || p->cmd!=0x01u) return false;
+    if(p->len!=1u && p->len!=4u){d->app_ignored++;return false;}
+    uint8_t ask=p->payload[0];
+    if(!ask || ask>G30_DASH_MAX_PAYLOAD){d->app_ignored++;return false;}
+    if(p->dst!=0x20u && p->dst!=0x22u) return false;
+    if(d->app_deferred){d->app_ignored++;d->app_deferred_dropped++;return false;}
+    d->app_deferred_src=p->src;
+    d->app_deferred_dst=p->dst;
+    d->app_deferred_arg=p->arg;
+    d->app_deferred_ask=ask;
+    d->app_deferred=1u;
+    d->app_deferred_queued++;
+    if(p->dst==0x20u) d->app_reads++; else d->bms_reads++;
+    return true;
+}
+
+static unsigned g30_dash_build_deferred_app_reply(dash_link_state *d,uint8_t *out){
+    uint8_t data[G30_DASH_MAX_PAYLOAD];
+    if(!d->app_deferred) return 0u;
+    if(d->app_deferred_dst==0x20u)
+        g30_dash_read_esc(d->app_deferred_arg,d->app_deferred_ask,data);
+    else if(d->app_deferred_dst==0x22u)
+        g30_dash_read_bms(d->app_deferred_arg,d->app_deferred_ask,data);
+    else return 0u;
+    return g30_dash_frame(d->app_deferred_dst,d->app_deferred_src,0x04u,
+        d->app_deferred_arg,data,d->app_deferred_ask,out);
+}
+#endif
 #endif
 
