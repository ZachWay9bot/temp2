+#ifdef G30_SHUD4_STRICT_DRIVETRAIN_V1
+void VescToSTM_g30_shud4_apply_request(int32_t request_ma, bool motor_enabled){
+    /* Hardware adapter only. SHUD4 owns the signed request and enable state.
+     * Do not route through SESC speed PI / torque policy / brake policy. */
+    qd_t ref={0,0};
+    int32_t q=current_to_torque(request_ma);
+    q*=DIR_MUL;
+    if(q>32767)q=32767;
+    if(q<-32767)q=-32767;
+    ref.q=(int16_t)q;
+    ref.d=0;
+    MCI_SetCurrentReferences(pMCI[M1],ref);
+    FOCVars[M1].hTeref=ref.q;
+    if(!motor_enabled){
+        ref.q=0;
+        MCI_SetCurrentReferences(pMCI[M1],ref);
+        FOCVars[M1].hTeref=0;
+        if(!PWM_Handle_M1._Super.PWM_off){
+            PWMC_SwitchOffPWM(&PWM_Handle_M1._Super);
+            PIDIqHandle_M1.wIntegralTerm=0;
+            PIDIdHandle_M1.wIntegralTerm=0;
+            FOCVars[M1].Vqd.q=0;
+            FOCVars[M1].Vqd.d=0;
+            extern void g30_drv126_final_reset(void);
+            g30_drv126_final_reset();
+        }
+        return;
+    }
+    if(!VescToSTM_g30_hall_feedback_valid()) return;
+    if(STM_GetState(&STM[M1])==IDLE){
+        MCI_ExecSpeedRamp(pMCI[M1],0,0);
+        (void)MCI_StartMotor(pMCI[M1]);
+    }else if(STM_GetState(&STM[M1])==RUN && PWM_Handle_M1._Super.PWM_off){
+        VescToSTM_pwm_start();
+    }
+}
+#endif
