 /* One consumer: DASH task. No second motor-control task is created. */
+#ifdef G30_SHUD4_STRICT_DRIVETRAIN_V1
+/* STRICT SHUD4 slow-drive reconstruction. These are direct translations of
+ * the frozen SHUD4 delta reference around 0x08001CA0 and 0x08001E00.
+ * No SESC speed PI, torque ramp, brake PI, coast helper, HSYNC or observer
+ * participates in this path. SESC remains only the hardware/safety adapter. */
+enum {
+    SHUD4_ACT_SAFE_OFF=0,
+    SHUD4_ACT_DPC=1,
+    SHUD4_ACT_BRAKE=2,
+    SHUD4_ACT_RELEASE=3
+};
+static int32_t shud4_clamp32(int32_t x,int32_t lo,int32_t hi){return x<lo?lo:(x>hi?hi:x);}
+static int32_t shud4_slew(int32_t cur,int32_t target,int32_t step){
+    int32_t d=target-cur;
+    if(d>step)return cur+step;
+    if(d<-step)return cur-step;
+    return target;
+}
+static int32_t shud4_hall_rate(void){
+    /* Native SHUD4 speed settings use the patched wheel/unit factor 313.
+     * VescToSTM_get_speed() is the board-adapter road speed in m/s. */
+    float kph=VescToSTM_get_speed()*3.6f;
+    if(!isfinite(kph)) return 0;
+    float r=kph*313.0f;
+    if(r>2147480000.0f) return 2147480000;
+    if(r<-2147480000.0f) return -2147480000;
+    return (int32_t)(r>=0.0f ? r+0.5f : r-0.5f);
+}
+static int32_t shud4_dpc_target(uint8_t raw){
+    int32_t n=shud4_clamp32((int32_t)raw-55,0,120);
+    /* SHUD4: phase/current limit 55000, quadratic selector, coeff 110. */
+    return (int32_t)(((int64_t)55000*n*n)/(110*110));
+}
+static void shud4_safe_off(dash_link_state *d){
+    d->shud4.request_ma=0;
+    d->shud4.target_ma=0;
+    d->shud4.motor_enabled=0;
+    d->shud4.action=SHUD4_ACT_SAFE_OFF;
+    d->shud4.applied_ma=0;
+    VescToSTM_g30_shud4_apply_request(0,false);
+}
+static void shud4_brake_release_step(dash_link_state *d,bool brake_active){
+    int32_t rate=d->shud4.hall_rate;
+    if(d->shud4.derating<20u){shud4_safe_off(d);return;}
+    if(brake_active){
+        if(rate>945){
+            d->shud4.motor_enabled=1;
+            int32_t b=shud4_clamp32((int32_t)d->brake-55,0,130);
+            int32_t mag=5000 + b*(30000-5000)/130;
+            int32_t target=-mag;
+            if(target<-30000)target=-30000;
+            target=(target*(int32_t)d->shud4.derating)/2048;
+            d->shud4.target_ma=target;
+            d->shud4.request_ma=shud4_slew(d->shud4.request_ma,target,500);
+            d->shud4.low_speed_shutdown_count=0;
+            return;
+        }
+        d->shud4.target_ma=0;
+        if(rate>400){
+            d->shud4.request_ma=shud4_slew(d->shud4.request_ma,0,500);
+            return;
+        }
+        d->shud4.request_ma=0;
+        if(++d->shud4.low_speed_shutdown_count>4u){
+            d->shud4.motor_enabled=0;
+            d->shud4.low_speed_shutdown_count=0;
+        }
+        return;
+    }
+    d->shud4.target_ma=0;
+    if(rate>500){
+        /* SHUD4 no_kers: passive release anchor is patched to zero, but the
+         * motor-enabled state is retained while rolling above this threshold. */
+        d->shud4.request_ma=shud4_slew(d->shud4.request_ma,0,1500);
+        d->shud4.low_speed_shutdown_count=0;
+        return;
+    }
+    if(rate>400){
+        if(d->shud4.request_ma==0){d->shud4.motor_enabled=0;return;}
+        d->shud4.request_ma=shud4_slew(d->shud4.request_ma,0,500);
+        return;
+    }
+    d->shud4.request_ma=0;
+    d->shud4.motor_enabled=0;
+    d->shud4.low_speed_shutdown_count=0;
+}
+static void handle_control(dash_link_state *d) {
+    uint32_t now=HAL_GetTick();
+    bool fresh=d->input_seen && (uint32_t)(now-d->last_input_ms)<=G30_DASH_R2_STALE_MS;
+    bool ready=pMCI[M1] && pMCI[M1]->pSTM && !app_is_output_disabled() &&
+               VescToSTM_get_fault()==FAULT_CODE_NONE;
+    d->shud4.hall_rate=shud4_hall_rate();
+    d->shud4.derating=ready?2048u:0u;
+    d->shud4.steps++;
+    /* Stock/SHUD dashboard valid raw window is 0x1E..0xD2. */
+    bool valid_raw=d->gas>=0x1Eu && d->gas<=0xD2u && d->brake>=0x1Eu && d->brake<=0xD2u;
+    if(!fresh || !ready || !valid_raw){
+        if(fresh && !valid_raw)d->shud4.invalid_inputs++;
+        shud4_safe_off(d);
+        return;
+    }
+    bool brake_active=d->brake>55u;
+    bool throttle_active=d->gas>55u;
+    if(brake_active){
+        d->shud4.action=SHUD4_ACT_BRAKE;
+        shud4_brake_release_step(d,true);
+    }else if(throttle_active){
+        d->shud4.action=SHUD4_ACT_DPC;
+        if(d->shud4.hall_rate<0){
+            d->shud4.request_ma=0;
+            d->shud4.target_ma=0;
+            d->shud4.motor_enabled=0;
+        }else{
+            d->shud4.motor_enabled=1;
+            d->shud4.low_speed_shutdown_count=0;
+            d->shud4.target_ma=shud4_dpc_target(d->gas);
+            d->shud4.request_ma=shud4_slew(d->shud4.request_ma,d->shud4.target_ma,6500);
+        }
+    }else{
+        d->shud4.action=SHUD4_ACT_RELEASE;
+        shud4_brake_release_step(d,false);
+    }
+    d->shud4.applied_ma=d->shud4.request_ma;
+    VescToSTM_g30_shud4_apply_request(d->shud4.request_ma,d->shud4.motor_enabled!=0u);
+    VescToSTM_timeout_reset();
+}
