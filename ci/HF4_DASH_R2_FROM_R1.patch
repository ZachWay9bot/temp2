     uint32_t tx_calls, tx_ok, tx_fail, rx_errors;
     uint16_t version;
     uint8_t gas, brake, init_result, rx_result, tx_result;
+    uint8_t input_seen;
+    volatile uint8_t remote_claimed;
+    volatile uint32_t last_remote_ms;
+    uint32_t last_input_ms, drive_commands, coast_commands, remote_claims;
+    g30_dash_r2_control control;
 } dash_link_state;
 /* SRAM footprint is allocated from the existing FreeRTOS heap, not carved
  * out of the almost-full static data region. One UART owner, one task. */
 static dash_link_state *dash;
 static uint32_t alloc_failed;
+
+/* Called on legitimate IoT VESC motor-control packets, before their setter.
+ * The existing VESC command contents and motor setters are NOT changed. */
+void g30_dash_link_vesc_claim(void) {
+    dash_link_state *d=dash;
+    if(!d) return;
+    d->last_remote_ms=HAL_GetTick();
+    d->remote_claimed=1u;
+    g30_dash_r2_remote_claim(&d->control);
+    d->remote_claims++;
+}
+
+/* Called only by the IoT VESC command dispatcher. Dashboard input is
+ * fresh/CRC-validated before a brake is permitted to inhibit motor commands. */
+bool g30_dash_link_brake_active(void) {
+    dash_link_state *d=dash;
+    if (!d || !d->input_seen) return false;
+    uint32_t now=HAL_GetTick();
+    return (uint32_t)(now-d->last_input_ms)<=G30_DASH_R2_STALE_MS &&
+           d->brake>=G30_DASH_R2_BRAKE_BEGIN &&
+           d->brake<=G30_DASH_R2_INPUT_MAX;
+}
+
+/* One consumer: DASH task. No second motor-control task is created. */
+static void handle_control(dash_link_state *d) {
+    uint32_t now=HAL_GetTick();
+    bool fresh=d->input_seen &&
+        (uint32_t)(now-d->last_input_ms) <= G30_DASH_R2_STALE_MS;
+    bool remote_busy=d->remote_claimed &&
+        (uint32_t)(now-d->last_remote_ms) < G30_DASH_R2_VESC_HOLD_MS;
+    if(!remote_busy) d->remote_claimed=0u;
+    /* Undervoltage/MCSDK faults block any torque while on 5V logic alone. */
+    bool ready=g30_runtime_ready && !app_is_output_disabled() &&
+        VescToSTM_get_fault()==FAULT_CODE_NONE &&
+        VescToSTM_get_bus_voltage()>=18.0f;
+    g30_dash_r2_action action=g30_dash_r2_step(&d->control,now,
+        d->gas,d->brake,fresh,remote_busy,ready);
+    if(action==G30_DASH_R2_COAST) {
+        /* Existing HF4 brake implementation is true coast, never regen. */
+        VescToSTM_set_brake(0);
+        VescToSTM_g30_pushstart_command(false);
+        d->coast_commands++;
+    } else if(action==G30_DASH_R2_DRIVE) {
+        /* A valid neutral-to-throttle transition arms the ORIGINAL
+         * >=3 km/h sensorless push-start. Not a stationary start path. */
+        uint16_t torque=g30_dash_r2_scale(d->gas);
+        if(!torque) return;
+        VescToSTM_g30_pushstart_command(true);
+        VescToSTM_set_current_rel_int((int32_t)torque);
+        VescToSTM_timeout_reset();
+        d->drive_commands++;
+    }
+}
 
 static unsigned rx_pos(dash_link_state *d) {
     return (128u-d->port->uart->hdmarx->Instance->CNDTR)&127u;
