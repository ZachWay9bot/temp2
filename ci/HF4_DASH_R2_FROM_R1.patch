+/* HF4 dashboard link R2: calibrated gas/brake through original HF4
+ * sensorless push-start and bounded VESC torque path, no FOC changes.
+ * Stock dashboard status/CRC/transport and IoT IAP are preserved. */
 #include "main.h"
 #include "task_init.h"
