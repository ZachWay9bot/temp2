+/* G30 HF4 DASH R2 - pure input calibration and motor-request arbitration.
+ * No hardware access here; host-regression testable. */
+#ifndef G30_DASH_DRIVE_LOGIC_H
+#define G30_DASH_DRIVE_LOGIC_H
+#include <stdint.h>
+#include <stdbool.h>
+
+#define G30_DASH_R2_GAS_IDLE       67u
+#define G30_DASH_R2_GAS_BEGIN      75u
+#define G30_DASH_R2_GAS_FULL      190u
+#define G30_DASH_R2_BRAKE_IDLE     34u
+#define G30_DASH_R2_BRAKE_BEGIN    45u
+#define G30_DASH_R2_BRAKE_RELEASE  40u
+#define G30_DASH_R2_INPUT_MAX    210u
+#define G30_DASH_R2_NEUTRAL_MS   200u
+#define G30_DASH_R2_STALE_MS     250u
+#define G30_DASH_R2_COMMAND_MS    40u
+#define G30_DASH_R2_VESC_HOLD_MS 1500u
+
+typedef enum {
+    G30_DASH_R2_NONE = 0,
+    G30_DASH_R2_DRIVE = 1,
+    G30_DASH_R2_COAST = 2
+} g30_dash_r2_action;
+typedef struct {
+    uint32_t neutral_since_ms, last_drive_ms;
+    uint8_t neutral_started, armed, driving, brake_override;
+} g30_dash_r2_control;
+
+static inline uint16_t g30_dash_r2_scale(uint8_t gas) {
+    if(gas <= G30_DASH_R2_GAS_BEGIN) return 0u;
+    if(gas >= G30_DASH_R2_GAS_FULL) return 32768u;
+    return (uint16_t)(((uint32_t)(gas-G30_DASH_R2_GAS_BEGIN)*32768u) /
+                 (G30_DASH_R2_GAS_FULL-G30_DASH_R2_GAS_BEGIN));
+}
+
+/* Remote VESC takes over without an intervening Dashboard COAST command. */
+static inline void g30_dash_r2_remote_claim(g30_dash_r2_control *c) {
+    c->driving=0u;
+    c->armed=0u;
+    c->neutral_started=0u;
+}
+
+static inline g30_dash_r2_action g30_dash_r2_step(g30_dash_r2_control *c,
+        uint32_t now_ms, uint8_t gas, uint8_t brake,
+        bool fresh, bool remote_busy, bool motor_ok) {
+    bool valid = fresh && gas <= G30_DASH_R2_INPUT_MAX &&
+                 brake <= G30_DASH_R2_INPUT_MAX;
+    bool braking = fresh && brake >= G30_DASH_R2_BRAKE_BEGIN &&
+                   brake <= G30_DASH_R2_INPUT_MAX;
+    /* The physical dashboard brake wins, including while VESC Tool owns drive.
+     * Generate ONE coast edge on brake engagement. Nonzero VESC commands
+     * themselves are also inhibited while this brake input is current. */
+    if (braking) {
+        bool need_coast = c->driving || (remote_busy && !c->brake_override);
+        c->brake_override=1u;
+        c->driving=0u;
+        c->armed=0u;
+        c->neutral_started=0u;
+        return need_coast ? G30_DASH_R2_COAST : G30_DASH_R2_NONE;
+    }
+    c->brake_override=0u;
+    if(remote_busy) {
+        g30_dash_r2_remote_claim(c);
+        return G30_DASH_R2_NONE;
+    }
+    bool neutral = valid && gas <= G30_DASH_R2_GAS_BEGIN &&
+                   brake <= G30_DASH_R2_BRAKE_RELEASE;
+
+    if(!valid || braking) {
+        c->armed=0u;
+        c->neutral_started=0u;
+    } else if(neutral) {
+        if(!c->neutral_started) {
+            c->neutral_since_ms=now_ms;
+            c->neutral_started=1u;
+        } else if((uint32_t)(now_ms-c->neutral_since_ms)>=G30_DASH_R2_NEUTRAL_MS) {
+            c->armed=1u;
+        }
+    } else {
+        c->neutral_started=0u;
+    }
+
+    bool request=valid && c->armed && !braking && motor_ok &&
+                 gas>G30_DASH_R2_GAS_BEGIN;
+    if(!request) {
+        if(c->driving) {
+            c->driving=0u;
+            return G30_DASH_R2_COAST;
+        }
+        return G30_DASH_R2_NONE;
+    }
+    if(!c->driving || (uint32_t)(now_ms-c->last_drive_ms)>=G30_DASH_R2_COMMAND_MS) {
+        c->driving=1u;
+        c->last_drive_ms=now_ms;
+        return G30_DASH_R2_DRIVE;
+    }
+    return G30_DASH_R2_NONE;
+}
+#endif
