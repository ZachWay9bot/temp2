 static HAL_StatusTypeDef g30_dash_tx_stocklike(dash_link_state *d,const uint8_t *buf,uint16_t len){
     UART_HandleTypeDef *u=d->port->uart;
     if(!buf || !len || u->Instance!=USART2) return HAL_ERROR;
+#ifdef G30_DASH_APPCOMPAT_V4
+    /* Hardware-proven EBiCS r5 physical TX order, adapted only at the RX
+     * restore point so SESC keeps its DMA receive architecture:
+     *   wait TXE while still in RX
+     *   PA2 AF push-pull
+     *   CR1 = UE|TE (direct write: no RX/PE IRQ bits during TX)
+     *   write byte, wait TC
+     *   PA2 AF open-drain
+     *   clear SR/DR
+     *   restore the exact pre-TX SESC RX CR1
+     * This deliberately does NOT alter USART1/IoT, USART3/BMS or CR3/DMAR. */
+    const uint32_t rx_cr1=u->Instance->CR1;
+    for(uint16_t i=0;i<len;i++){
+        uint32_t start=HAL_GetTick();
+        while((u->Instance->SR & USART_SR_TXE)==0u){
+            if((uint32_t)(HAL_GetTick()-start)>2u) goto fail;
+        }
+        g30_dash_pa2_crl(0xBu);
+        u->Instance->CR1=USART_CR1_UE|USART_CR1_TE;
+        u->Instance->DR=buf[i];
+        start=HAL_GetTick();
+        while((u->Instance->SR & USART_SR_TC)==0u){
+            if((uint32_t)(HAL_GetTick()-start)>2u) goto fail;
+        }
+        g30_dash_pa2_crl(0xFu);
+        (void)u->Instance->SR;(void)u->Instance->DR;
+        u->Instance->CR1=rx_cr1;
+    }
+    return HAL_OK;
+#else
     for(uint16_t i=0;i<len;i++){
         uint32_t start=HAL_GetTick();
         /* AF push-pull, 50 MHz: CRL nibble 0xB on PA2. */
@@ -137,9 +167,17 @@
         MODIFY_REG(u->Instance->CR1,USART_CR1_TE|USART_CR1_RE,USART_CR1_RE);
     }
     return HAL_OK;
+#endif
 fail:
     d->tx_byte_timeouts++;
     g30_dash_pa2_crl(0xFu);
+#ifdef G30_DASH_APPCOMPAT_V4
+    (void)u->Instance->SR;(void)u->Instance->DR;
+    u->Instance->CR1=rx_cr1;
+#else
     MODIFY_REG(u->Instance->CR1,USART_CR1_TE|USART_CR1_RE,USART_CR1_RE);
+#endif
     return HAL_TIMEOUT;
 }
