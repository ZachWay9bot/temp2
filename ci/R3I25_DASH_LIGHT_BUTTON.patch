--- a/common_files/src/task_pwr.c
+++ b/common_files/src/task_pwr.c
@@ -71,7 +71,7 @@
     /* G30D button state machine. A normal dashboard click must never be
      * interpreted as power-off. LONG_PRESS is emitted only after a deliberate
      * >=2500 ms hold has been released. For double click, the second press must
-     * begin within 250 ms; its release does not have to fit into that window. */
+     * begin within 500 ms; its release does not have to fit into that window. */
     /* pending: 0 = none, 1 = first short released, 2 = second press active */
     static uint8_t pressed, pending;
     static uint32_t pressed_at, released_at;
@@ -81,7 +81,7 @@
     if(down && !pressed) {
         pressed = 1u;
         pressed_at = now;
-        if(pending == 1u && (uint32_t)(now - released_at) <= 250u)
+        if(pending == 1u && (uint32_t)(now - released_at) <= 500u)
             pending = 2u;
     } else if(!down && pressed) {
         pressed = 0u;
@@ -102,7 +102,7 @@
             pending = 1u;
         }
     }
-    if(!pressed && pending == 1u && (uint32_t)(now - released_at) > 250u) {
+    if(!pressed && pending == 1u && (uint32_t)(now - released_at) > 500u) {
         pending = 0u;
         return SINGLE_PRESS;
     }
