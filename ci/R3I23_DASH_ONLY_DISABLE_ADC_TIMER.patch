--- a/common_files/src/app_uartcomm.c
+++ b/common_files/src/app_uartcomm.c
@@ -266,16 +266,28 @@
 uint32_t app_updaterate(){
 	return 2000 / config.update_rate_hz;
 }
 
 void app_check_timer(){
+#ifdef G30P
+	/* R3I23 DASH-ONLY: the legacy ADC control timer must never run on G30.
+	 * Stock-dash input is owned by g30_dash_link.c; VESC Tool remains on
+	 * USART1. Keep mode/TEMP helpers from this module, but no second motor
+	 * command source is allowed. */
+	return;
+#else
 	if(xTimerIsTimerActive(xTimer)==pdFALSE){
 		xTimerChangePeriod(xTimer, app_updaterate(),100);
 		xTimerStart(xTimer, 100);
 	}
+#endif
 }
 
 void app_adc_init_timer(){
+#ifdef G30P
+	/* See app_check_timer(): deliberately do not create ADC_UP on G30. */
+	return;
+#else
 	if(xTimer==NULL){
 		xTimer = xTimerCreate("ADC_UP",app_updaterate() , pdTRUE, ( void * ) 0,vTimerCallback );
 	}
+#endif
 }
 
 void app_timer_update_period(){
 	xTimerChangePeriod(xTimer, app_updaterate(), 1000);
 }
