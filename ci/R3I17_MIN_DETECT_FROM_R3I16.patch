diff --git a/common_files/src/conf_general.c b/common_files/src/conf_general.c
index 0dd0db4..5d2324a 100644
--- a/common_files/src/conf_general.c
+++ b/common_files/src/conf_general.c
@@ -513,6 +513,62 @@ void conf_general_calc_apply_foc_cc_kp_ki_gain(mc_configuration *mcconf, float t
  *  -x: see conf_general_autodetect_apply_sensors_foc faults
  */
 int conf_general_detect_apply_all_foc(float max_power_loss,	bool store_mcconf_on_success, bool send_mcconf_on_success, PACKET_STATE_t * phandle) {
+#ifdef G30P
+	/* R3I17 G30 minimal detect: identify only R, L and flux linkage. Preserve
+	 * Hall table, current limits, 15 pole pairs and the selected sensor mode. */
+	(void)store_mcconf_on_success;
+	(void)send_mcconf_on_success;
+	mc_configuration *saved = pvPortMalloc(sizeof(mc_configuration));
+	if(saved == NULL) return -12;
+	*saved = mc_conf;
+
+	mc_foc_sensor_mode selected_sensor_mode = saved->foc_sensor_mode;
+	if(selected_sensor_mode != FOC_SENSOR_MODE_HALL &&
+	   selected_sensor_mode != FOC_SENSOR_MODE_SENSORLESS){
+		selected_sensor_mode = FOC_SENSOR_MODE_HALL;
+	}
+
+	vTaskDelay(MS_TO_TICKS(1000));
+	VescToSTM_enable_timeout(false);
+
+	float r = 0.0f, l = 0.0f, i_max = 0.0f;
+	bool rl_ok = tune_foc_measure_r_l_imax(saved->cc_min_current,
+			saved->l_current_max, max_power_loss, &r, &l, &i_max);
+	if(!rl_ok || r <= 0.0f || l <= 0.0f){
+		VescToSTM_enable_timeout(true);
+		conf_general_setup_mc(saved);
+		vPortFree(saved);
+		return -11;
+	}
+
+	float lambda = 0.0f, lambda_undriven = 0.0f, undriven_samples = 0.0f;
+	bool flux_ok = tune_foc_measure_flux_linkage_openloop(i_max / 2.5f,
+			0.3f, 1800.0f, r, l, &lambda, &lambda_undriven, &undriven_samples);
+	if(undriven_samples > 60.0f && lambda_undriven > 0.0f) lambda = lambda_undriven;
+	if(!flux_ok || lambda <= 0.0f){
+		VescToSTM_enable_timeout(true);
+		conf_general_setup_mc(saved);
+		vPortFree(saved);
+		return -10;
+	}
+
+	saved->motor_type = MOTOR_TYPE_FOC;
+	saved->foc_f_sw = 16000.0f;
+	saved->foc_motor_r = r;
+	saved->foc_motor_l = l;
+	saved->foc_motor_flux_linkage = lambda;
+	saved->foc_sensor_mode = selected_sensor_mode;
+	conf_general_calc_apply_foc_cc_kp_ki_gain(saved, 1000.0f);
+	conf_general_setup_mc(saved);
+
+	/* The local CAN wrapper in this tree only returns the result code, so the
+	 * G30 path explicitly publishes and stores the detected mcconf here. */
+	commands_send_mcconf(COMM_GET_MCCONF, saved, phandle);
+	conf_general_store_mc_configuration(saved, false);
+	VescToSTM_enable_timeout(true);
+	vPortFree(saved);
+	return 1;
+#else
 	int result = -1;
 
 	mc_configuration *mcconf = &mc_conf;
@@ -616,6 +672,7 @@ int conf_general_detect_apply_all_foc(float max_power_loss,	bool store_mcconf_on
 	vPortFree(mcconf_old);
 
 	return result;
+#endif
 }
 
