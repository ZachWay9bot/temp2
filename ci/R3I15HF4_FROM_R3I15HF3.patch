--- a/common_files/src/VescToSTM.c
+++ b/common_files/src/VescToSTM.c
@@ -374,16 +374,28 @@
      * command. Arm exactly once on the first non-zero VESC drive request.
      * Repeated control packets must not reset an in-progress/running start. */
     g30_r3i_diag_t ps=g30_r3i_get_diag();
     g30_r3i_set_drive_request(1u);
-    if(ps.mode==2u) return;
+    if(ps.mode==2u){
+        /* HF4: FO76 can request Coast after a catch/observer fallback while
+         * g30_r3i still says mode 2. Do not leave Auto-Arm in this zombie
+         * state. Clear the failed takeover once and return to armed BEMF
+         * capture. Repeated VESC drive packets will then restart MCSDK as
+         * soon as its stop state reaches IDLE. */
+        if(!g30_fo76_coast_requested()) return;
+        VescToSTM_pwm_stop();
+        g30_fo76_sensorless_clear();
+        g30_fo76_request_takeover(0u);
+        g30_r3i_request_arm(1u);
+        ps=g30_r3i_get_diag();
+    }
     if(ps.mode==1u){
-        /* HF3: rolling re-catch keeps the passive BEMF history. After a true
-         * stop, stale phase/edge history is discarded so the next push starts
-         * exactly like a cold Hall-free start. */
-        if(g30_r3i_motion_recent()) return;
-        g30_r3i_request_arm(1u);
+        /* HF4: never reset passive BEMF history on repeated non-zero VESC
+         * packets. That was preventing the required edge count from building
+         * after a full stop. Only restart the MCSDK state machine when it has
+         * actually returned to IDLE. */
+        if(STM_GetState(&STM[M1])==IDLE){
+            MCI_ExecSpeedRamp(pMCI[M1],0,0);
+            (void)MCI_StartMotor(pMCI[M1]);
+        }
         return;
     }
 
