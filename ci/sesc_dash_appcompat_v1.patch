+#ifdef G30_DASH_APPCOMPAT_V1
+/* r5 hardware-proven dashboard TX behavior: PA2 is actively driven as AF
+ * push-pull for each byte, then immediately released as AF open-drain with RX
+ * re-enabled after TC. This mirrors stock DRV126's physical Yellowwire service
+ * and leaves USART1/IoT and USART3/BMS completely untouched. */
+static inline void g30_dash_pa2_crl(uint32_t nibble){
+    uint32_t crl=GPIOA->CRL;
+    crl=(crl & ~(0xFu<<8)) | ((nibble&0xFu)<<8);
+    GPIOA->CRL=crl;
+}
+static HAL_StatusTypeDef g30_dash_tx_stocklike(dash_link_state *d,const uint8_t *buf,uint16_t len){
+    UART_HandleTypeDef *u=d->port->uart;
+    if(!buf || !len || u->Instance!=USART2) return HAL_ERROR;
+    for(uint16_t i=0;i<len;i++){
+        uint32_t start=HAL_GetTick();
+        /* AF push-pull, 50 MHz: CRL nibble 0xB on PA2. */
+        g30_dash_pa2_crl(0xBu);
+        MODIFY_REG(u->Instance->CR1,USART_CR1_TE|USART_CR1_RE,USART_CR1_TE);
+        while((u->Instance->SR & USART_SR_TXE)==0u){
+            if((uint32_t)(HAL_GetTick()-start)>2u) goto fail;
+        }
+        (void)u->Instance->SR;
+        u->Instance->DR=buf[i];
+        start=HAL_GetTick();
+        while((u->Instance->SR & USART_SR_TC)==0u){
+            if((uint32_t)(HAL_GetTick()-start)>2u) goto fail;
+        }
+        /* Stock releases the single wire after every byte. */
+        g30_dash_pa2_crl(0xFu);
+        MODIFY_REG(u->Instance->CR1,USART_CR1_TE|USART_CR1_RE,USART_CR1_RE);
+    }
+    return HAL_OK;
+fail:
+    d->tx_byte_timeouts++;
+    g30_dash_pa2_crl(0xFu);
+    MODIFY_REG(u->Instance->CR1,USART_CR1_TE|USART_CR1_RE,USART_CR1_RE);
+    return HAL_TIMEOUT;
+}
+
+static bool g30_dash_serial_char(uint8_t c){
+    return (c>='0'&&c<='9') || (c>='A'&&c<='Z');
+}
+static void g30_dash_get_serial(uint8_t out[14]){
+    const uint8_t *begin=(const uint8_t*)0x0801C000u;
+    const uint8_t *end=(const uint8_t*)0x0801E000u;
+    for(const uint8_t *q=begin;q+14u<=end;q++){
+        if(q[0]!='N'||q[1]!='4'||q[2]!='G') continue;
+        uint8_t ok=1u;
+        for(unsigned i=0;i<14u;i++) if(!g30_dash_serial_char(q[i])){ok=0u;break;}
+        if(ok){memcpy(out,q,14u);return;}
+    }
+    /* After a historical mass erase the stock identity page may be blank.
+     * Keep a syntactically valid, stable non-secret fallback. BLE117 returns
+     * the same 14 bytes in 5B and the app echoes them in 5D. */
+    static const uint8_t fallback[14]={'N','4','G','S','E','S','C','0','0','0','0','0','0','0'};
+    memcpy(out,fallback,14u);
+}
+static void g30_put_u16(uint8_t *p,uint16_t v){p[0]=(uint8_t)v;p[1]=(uint8_t)(v>>8);}
+static void g30_put_u32(uint8_t *p,uint32_t v){p[0]=(uint8_t)v;p[1]=(uint8_t)(v>>8);p[2]=(uint8_t)(v>>16);p[3]=(uint8_t)(v>>24);}
+
