+static bool g30_dash_queue_app_read(dash_link_state *d,uint8_t out[65],uint16_t *outlen){
+    const g30_dash_parser *p=&d->parser;
+    if((p->src<0x3Du||p->src>0x3Fu) || p->cmd!=0x01u) return false;
+    if(p->len!=1u && p->len!=4u){d->app_ignored++;return false;}
+    uint8_t ask=p->payload[0];
+    if(!ask || ask>G30_DASH_MAX_PAYLOAD){d->app_ignored++;return false;}
+    uint8_t data[G30_DASH_MAX_PAYLOAD];
+    if(p->dst==0x20u){g30_dash_read_esc(p->arg,ask,data);d->app_reads++;}
+    else if(p->dst==0x22u){g30_dash_read_bms(p->arg,ask,data);d->bms_reads++;}
+    else return false;
+    *outlen=(uint16_t)g30_dash_frame(p->dst,p->src,0x04u,p->arg,data,ask,out);
+    return *outlen!=0u;
+}
+#endif
