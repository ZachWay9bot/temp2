+static inline unsigned g30_dash_frame(uint8_t src,uint8_t dst,uint8_t cmd,uint8_t arg,
+        const uint8_t *payload,uint8_t len,uint8_t *out) {
+    uint16_t sum=0;
+    if(len>G30_DASH_MAX_PAYLOAD) return 0u;
+    out[0]=0x5Au; out[1]=0xA5u; out[2]=len; out[3]=src; out[4]=dst;
+    out[5]=cmd; out[6]=arg;
+    if(len && payload) memcpy(out+7,payload,len);
+    for(unsigned i=2;i<(unsigned)(7u+len);i++) sum=(uint16_t)(sum+out[i]);
+    sum^=0xFFFFu;
+    out[7u+len]=(uint8_t)sum; out[8u+len]=(uint8_t)(sum>>8);
+    return (unsigned)(9u+len);
+}
