+extern uint8_t g30_bms_stock_copy_serial(uint8_t *out,uint8_t maxlen);
+#endif
+
+static uint8_t g30_dash_read_esc(uint8_t reg,uint8_t ask,uint8_t *out){
+    memset(out,0,ask);
+    switch(reg){
+    case 0x10u: { uint8_t serial[14]; g30_dash_get_serial(serial); memcpy(out,serial,ask<14u?ask:14u); } break;
+    case 0x1Au: if(ask>=2u){out[0]=0x20u;out[1]=0x04u;} break; /* empirical stock app value */
+    case 0x29u: if(ask>=4u) g30_put_u32(out,VescToSTM_get_odometer()); break; /* metres = 0.001 km */
+    case 0xB0u: if(ask>=2u) g30_put_u16(out,(uint16_t)(pMCI[M1]->pSTM->hFaultOccurred&0xFFFFu)); break;
+    case 0xB4u: if(ask>=2u){float l=VescToSTM_get_battery_level(0);if(!isfinite(l)||l<0)l=0;if(l>1)l=1;g30_put_u16(out,(uint16_t)(l*100.0f+0.5f));} break;
+    case 0xB5u: if(ask>=2u){float k=fabsf(VescToSTM_get_speed()*3.6f);if(!isfinite(k)||k<0)k=0;if(k>6553.5f)k=6553.5f;g30_put_u16(out,(uint16_t)(k*10.0f+0.5f));} break;
+    case 0xB7u: if(ask>=4u) g30_put_u32(out,VescToSTM_get_odometer()); break;
+    case 0xD0u: break; /* stock/unknown extension probe: zero-filled read */
+    default: break; /* readable but unknown: deterministic zero rather than timeout */
+    }
+    return ask;
+}
+
+static uint8_t g30_dash_read_bms(uint8_t reg,uint8_t ask,uint8_t *out){
+    memset(out,0,ask);
+#ifdef G30_SHUD4_BMS_V1
+    if(reg==0x10u){ (void)g30_bms_stock_copy_serial(out,ask); return ask; }
+    /* ScootBatt's proven request is 0x31, 12 bytes. Populate the contiguous
+     * stock fields from the already-running read-only 0x30 heartbeat cache. */
+    if(reg==0x31u){
+        if(ask>=2u) g30_put_u16(out+0,g30_bms_stock_remaining());
+        if(ask>=4u) g30_put_u16(out+2,g30_bms_stock_soc());
+        if(ask>=6u) g30_put_u16(out+4,(uint16_t)g30_bms_stock_current());
+        if(ask>=8u) g30_put_u16(out+6,g30_bms_stock_pack10());
+        if(ask>=10u) g30_put_u16(out+8,g30_bms_stock_temp_pair());
+        return ask;
+    }
+    if(reg==0x32u && ask>=2u) g30_put_u16(out,g30_bms_stock_soc());
+    else if(reg==0x33u && ask>=2u) g30_put_u16(out,(uint16_t)g30_bms_stock_current());
+    else if(reg==0x34u && ask>=2u) g30_put_u16(out,g30_bms_stock_pack10());
+    else if(reg==0x35u && ask>=2u) g30_put_u16(out,g30_bms_stock_temp_pair());
+#endif
+    return ask;
+}
