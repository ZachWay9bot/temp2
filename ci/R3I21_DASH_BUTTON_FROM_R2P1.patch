+    /* pending: 0 = none, 1 = first short released, 2 = second press active */
+    static uint8_t pressed, pending;
     static uint32_t pressed_at, released_at;
     uint32_t now = HAL_GetTick();
     uint8_t down = buttonState();
+
     if(down && !pressed) {
         pressed = 1u;
         pressed_at = now;
+        if(pending == 1u && (uint32_t)(now - released_at) <= 250u)
+            pending = 2u;
     } else if(!down && pressed) {
         pressed = 0u;
         uint32_t held_ms = (uint32_t)(now - pressed_at);
         if(held_ms >= 2500u) {
-            single_pending = 0u;
+            pending = 0u;
             return LONG_PRESS;
         }
         if(held_ms >= 30u) {
-            if(single_pending && (uint32_t)(now - released_at) <= 250u) {
-                single_pending = 0u;
+            if(pending == 2u) {
+                pending = 0u;
                 return DOUBLE_PRESS;
             }
-            single_pending = 1u;
+            pending = 1u;
             released_at = now;
+        } else if(pending == 2u) {
+            /* A bounced/too-short second press must not consume click #1. */
+            pending = 1u;
         }
     }
-    if(!pressed && single_pending && (uint32_t)(now - released_at) > 250u) {
-        single_pending = 0u;
+    if(!pressed && pending == 1u && (uint32_t)(now - released_at) > 250u) {
+        pending = 0u;
         return SINGLE_PRESS;
     }
     return NO_PRESS;
