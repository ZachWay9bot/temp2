+static void g30_ble_vesc_putbuffer(unsigned char *buf, unsigned int len, port_str *port){
+    /* The stock dashboard/nRF bridge accepts Ninebot frames only. Carry the
+     * already-framed VESC byte stream as ordered payload chunks. No second
+     * VESC protocol implementation and no large static buffer are needed. */
+    while(len){
+        uint8_t chunk=(len>NinebotMaxPayload)?NinebotMaxPayload:(uint8_t)len;
+        uint8_t tx[NinebotMaxPayload+9u];
+        uint8_t total=g30_dash_build_frame(g30_vesc_tunnel_peer,
+            G30_VESC_TUNNEL_CMD,G30_VESC_TUNNEL_ARG,buf,chunk,tx);
+        my_uart_send_data(tx,total,port);
+        buf+=chunk;
+        len-=chunk;
+    }
+}
+
+static void g30_ble_vesc_reply_packet(unsigned char *data, unsigned int len, PACKET_STATE_t *phandle){
+    packet_send_packet(data,len,phandle);
+}
