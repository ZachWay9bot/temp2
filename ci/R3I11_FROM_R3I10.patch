@@ -0,0 +1,71 @@
+#include "g30_hall_trace.h"
+
+/* 384 bytes of samples plus 24 bytes of state. No heap, division or actuator
+ * access. Only Hall edges copy records; no new periodic FOC work. */
+_Static_assert(sizeof(g30_hall_trace_sample_t)==16u,"trace record size");
+static g30_hall_trace_sample_t samples[G30_HALL_TRACE_CAPACITY];
+static uint32_t origin, run, edges;
+static volatile uint32_t seq;
+static uint8_t next=1u, count;
+static volatile uint8_t active, reason;
+#define BARRIER() __asm volatile("" ::: "memory")
+
+void g30_hall_trace_begin(const g30_hall_trace_sample_t *sample){
+    active=0u;
+    ++seq; BARRIER();
+    origin=sample->cycles; run++; edges=0u; next=1u; count=1u;
+    samples[0]=*sample;
+    samples[0].cycles=0u;
+    samples[0].flags|=G30_HT_SEED;
+    reason=G30_HT_RUNNING;
+    BARRIER(); ++seq; BARRIER();
+    active=1u;
+}
+
+void g30_hall_trace_edge(const g30_hall_trace_sample_t *sample){
+    if(!active)return;
+    ++seq; BARRIER();
+    samples[next]=*sample;
+    samples[next].cycles=sample->cycles-origin;
+    edges++;
+    if(count<G30_HALL_TRACE_CAPACITY)count++;
+    if(++next>=G30_HALL_TRACE_CAPACITY)next=1u;
+    BARRIER(); ++seq;
+}
+
+void g30_hall_trace_freeze(uint8_t why){
+    if(active){
+        reason=why;
+        BARRIER();
+        active=0u;
+    }
+}
+uint8_t g30_hall_trace_enabled(void){return active;}
+
+g30_hall_trace_meta_t g30_hall_trace_meta(void){
+    g30_hall_trace_meta_t out={0};
+    for(unsigned tries=0;tries<4u;tries++){
+        uint32_t before=seq; BARRIER();
+        out.run=run; out.total_edges=edges; out.count=count;
+        uint32_t dropped=edges>G30_HALL_TRACE_CAPACITY-1u?edges-(G30_HALL_TRACE_CAPACITY-1u):0u;
+        out.dropped=(uint16_t)(dropped>65535u?65535u:dropped);
+        out.active=active;out.reason=reason;
+        BARRIER();
+        if(!(before&1u) && before==seq){out.coherent=1u;return out;}
+    }
+    return out;
+}
+
+uint8_t g30_hall_trace_read(uint16_t index,g30_hall_trace_sample_t *out){
+    for(unsigned tries=0;tries<4u;tries++){
+        uint32_t before=seq; BARRIER();
+        if(index>=count)return 0u;
+        uint16_t physical=index;
+        if(index && edges>G30_HALL_TRACE_CAPACITY-1u)
+            physical=(uint16_t)(1u+((uint16_t)next-1u+index-1u)%(G30_HALL_TRACE_CAPACITY-1u));
+        *out=samples[physical];
+        BARRIER();
+        if(!(before&1u) && before==seq)return 1u;
+    }
+    return 0u;
+}
