+#ifndef G30_HALL_TRACE_H
+#define G30_HALL_TRACE_H
+#include <stdint.h>
+
+#define G30_HALL_TRACE_CAPACITY 24u
+#define G30_HT_RELIABLE 1u
+#define G30_HT_PWM_ON 2u
+#define G30_HT_SEED 4u
+#define G30_HT_COHERENT 8u
+enum { G30_HT_RUNNING=0, G30_HT_COAST=1, G30_HT_PWM_STOP=2, G30_HT_CLEAR=3 };
+
+typedef struct {
+    uint32_t cycles;
+    uint16_t hall, control, observer;
+    int16_t control_dpp;
+    uint16_t vbus_adc;
+    uint8_t hall_code, flags;
+} g30_hall_trace_sample_t;
+
+typedef struct {
+    uint32_t run, total_edges;
+    uint16_t count, dropped;
+    uint8_t active, reason, coherent;
+} g30_hall_trace_meta_t;
+
+/* begin: called with PWM off immediately after a BEMF seed; seed sample is
+ * always retained. edge: called only from the physical Hall capture IRQ.
+ * freeze: only publishes a byte; never writes the Hall IRQ's ring data. */
+void g30_hall_trace_begin(const g30_hall_trace_sample_t *sample);
+void g30_hall_trace_edge(const g30_hall_trace_sample_t *sample);
+void g30_hall_trace_freeze(uint8_t reason);
+uint8_t g30_hall_trace_enabled(void);
+g30_hall_trace_meta_t g30_hall_trace_meta(void);
+uint8_t g30_hall_trace_read(uint16_t index, g30_hall_trace_sample_t *out);
+#endif
